# Copy to .env (local dev) and set the same keys as Vercel
# environment variables (Production + Preview). NEVER commit
# real values — .env is gitignored.
#
# Database (Supabase Postgres or Vercel Postgres):
# Supabase dashboard → Project Settings → Database → Connection string.
# Use the pooled (port 6543) string for serverless, e.g.
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
POSTGRES_URL=postgresql://user:password@host:5432/postgres

# Local dev only: set to "disable" if your local Postgres has no TLS.
# Leave unset for hosted databases.
# POSTGRES_SSLMODE=disable

# Admin panel password (long random string recommended).
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Session signing secret (generate with: openssl rand -hex 32).
ADMIN_SESSION_SECRET=change-me-to-32-plus-random-bytes
